{
  "expo": {
    "name": "Stompers Faker",
    "slug": "stompers-faker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground-1024.png",
        "backgroundColor": "#FF5A1F"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.fasih.stompersfaker",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.WRITE_STEPS",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/brand/icon-96.png"
    },
    "plugins": [
      "expo-router",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-logo-288.png",
          "imageWidth": 200,
          "backgroundColor": "#F7F6F2",
          "dark": {
            "backgroundColor": "#111113"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Inter-Bold.ttf",
            "./assets/fonts/SpaceGrotesk-Bold.ttf",
            "./assets/fonts/JetBrainsMono-Regular.ttf"
          ]
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "scheme": "stompersfaker"
  }
}
